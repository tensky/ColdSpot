<?xml version="1.0" encoding="utf-8"?>
<!-- The bubble's disc, as the logo (A3) draws it at 48 dp: white, with a light rim, under ColdSpot's small mark. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/coldspot_bubble_ripple">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/coldspot_bubble" />
            <stroke
                android:width="1dp"
                android:color="@color/coldspot_bubble_rim" />
        </shape>
    </item>
</ripple>
